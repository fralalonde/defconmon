[Unit]
Description=defconmon config server (HTTP, LAN only)
Documentation=file:/var/home/fralalonde/Code/INFRA/dashboard-retro/README.md
After=network.target

[Service]
Type=simple
User=dashboard
Group=dashboard
ExecStart=/usr/local/bin/defconmon-config --config /etc/defconmon/config.json --serve 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
