[Unit]
Description=defconmon config server (HTTP, LAN only)
Documentation=file:/path/to/defconmon/README.md
After=network.target

[Service]
Type=simple
User=dashboard
Group=dashboard
ExecStart=/usr/local/bin/defconmon-config --config /etc/defconmon/config.json --serve 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
